# Smart Invoice - Environment Configuration Example
# Copy this file to .env and update with your actual values

# Django Settings
DEBUG=False
SECRET_KEY=generate-a-secure-random-key-here

# Database (PostgreSQL recommended for production)
# Leave blank to use SQLite (development only)
DATABASE_URL=postgresql://user:password@localhost:5432/smartinvoice

# Allowed Hosts (comma-separated domains)
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com,www.yourdomain.com

# Email Configuration (Gmail, SendGrid, or other SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@smartinvoice.com

# CSRF and Security
CSRF_TRUSTED_ORIGINS=https://*.yourdomain.com,https://*.render.com

# Optional: Sentry for error tracking (production)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Optional: WhatsApp Business API credentials (if using WhatsApp integration)
# WHATSAPP_API_KEY=your-api-key
# WHATSAPP_BUSINESS_PHONE_ID=your-phone-id

# Redis/Cache (optional, for production rate limiting)
# REDIS_URL=redis://localhost:6379/0
